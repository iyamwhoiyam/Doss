# Copy this to .env and adjust. Every value has a sensible default, so an empty
# .env (or none at all) gives you a working bare-IP deployment.

# The address Caddy serves on.
#   :80                     plain HTTP on the server's IP  (default; good for first boot)
#   ops.enovascience.com    a domain you control -> automatic HTTPS
SITE_ADDRESS=:80

# Allow the session cookie over plain HTTP. Required for the :80 / bare-IP setup
# above. Set to 0 once SITE_ADDRESS is a domain served over HTTPS.
ALLOW_INSECURE_COOKIE=1
